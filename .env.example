# Copy to .env.local.
# Local development: point the app at the emulators.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cig

# Production: set NEXT_PUBLIC_USE_EMULATORS=false and fill these from
# Firebase console → Project settings → Your apps → Web app.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=        # Cloud Messaging → Web Push certificates (staff push alerts)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=        # App Check → reCAPTCHA Enterprise site key (spam protection)
