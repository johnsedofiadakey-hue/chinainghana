rules_version = '2';

// Product images: products/{branchId}/{fileName}
service firebase.storage {
  match /b/{bucket}/o {

    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    function canManage(branchId) {
      return role() == 'admin' || role() == 'superadmin'
        || (role() == 'manager' && request.auth.token.get('branchId', '') == branchId);
    }

    match /products/{branchId}/{fileName} {
      allow read: if true;
      allow create, update: if canManage(branchId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if canManage(branchId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
