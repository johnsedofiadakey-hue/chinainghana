rules_version = '2';

// China-in-Ghana — Firestore Security Rules
// Roles live in Auth custom claims: { role: "superadmin" | "admin" | "manager", branchId?: string }
// All stock and money movements go through Cloud Functions (Admin SDK bypasses these rules).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function isSuper() {
      return role() == 'superadmin';
    }

    function isAdmin() {
      return role() == 'admin' || isSuper();
    }

    function isManager() {
      return role() == 'manager';
    }

    function isStaff() {
      return isAdmin() || isManager();
    }

    function canManage(branchId) {
      return isAdmin() || (isManager() && request.auth.token.get('branchId', '') == branchId);
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Settings ----------
    match /settings/app {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/license {
      allow read: if isAdmin();
      allow write: if isSuper();
    }

    // ---------- Users (staff profiles) ----------
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // Staff may only clear their own mustChangePassword flag; everything else is via functions.
      allow update: if signedIn() && request.auth.uid == uid
        && changedOnly(['mustChangePassword', 'updatedAt'])
        && request.resource.data.mustChangePassword == false;
      allow create, delete: if false;
    }

    // ---------- Branches ----------
    match /branches/{branchId} {
      allow read: if resource.data.active == true || isStaff();
      allow create, delete: if false; // createBranch function enforces the branch limit
      allow update: if (isAdmin()
          && request.resource.data.code == resource.data.code)
        || (isManager() && canManage(branchId)
          && changedOnly(['whatsapp', 'phone', 'hours', 'updatedAt']));
    }

    // ---------- Categories (shared) ----------
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ---------- Products (belong to one branch) ----------
    match /products/{productId} {
      allow read: if resource.data.visible == true || canManage(resource.data.branchId);
      allow create: if canManage(request.resource.data.branchId)
        && request.resource.data.stockPieces == 0;
      allow update: if canManage(resource.data.branchId)
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.stockPieces == resource.data.stockPieces;
      allow delete: if false; // hide instead of delete
    }

    // ---------- Orders (created by placeOrder) ----------
    match /orders/{orderId} {
      // Order IDs are random and unguessable: the link acts as the customer's view key.
      allow get: if true;
      allow list: if canManage(resource.data.branchId);
      allow write: if false;
    }

    // ---------- Sales (created by recordSale / order completion) ----------
    match /sales/{saleId} {
      allow get: if true; // receipt link /r/{saleId}
      allow list: if canManage(resource.data.branchId);
      allow write: if false;
    }

    // ---------- Read-only operational data ----------
    match /stockMovements/{id} {
      allow read: if canManage(resource.data.branchId);
      allow write: if false;
    }

    match /alerts/{id} {
      allow read: if canManage(resource.data.branchId);
      allow write: if false;
    }

    match /dailySummaries/{id} {
      allow read: if canManage(resource.data.branchId);
      allow write: if false;
    }

    match /stockTakes/{id} {
      allow read: if canManage(resource.data.branchId);
      allow write: if false; // submitStockTake / reviewStockTake
    }

    match /customers/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /counters/{id} {
      allow read, write: if false;
    }
  }
}
